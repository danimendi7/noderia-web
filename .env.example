# Copia este archivo como .env.local y rellénalo. .env.local nunca se sube a GitHub.

# Supabase STAGING (nunca las de producción: esas van en Vercel > Production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STAGING_DB_URL=

# Vercel > Settings > Deployment Protection > Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=

# URL de producción de Vercel (Domains)
PRODUCTION_URL=

# Sal para el hash de la IP del formulario (límite de envíos). Opcional pero recomendable.
IP_HASH_SALT=

// Worker de Cloudflare para la web (adaptador OpenNext, @opennextjs/cloudflare).
// Guía: https://opennext.js.org/cloudflare/get-started · Despliegue: docs/DESPLIEGUE-CLOUDFLARE.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "noderia-web",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    // API de Node.js (la necesita Next.js)
    "nodejs_compat",
    // fetch solo a URLs públicas (Supabase y Resend)
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Debe coincidir con "name"
      "binding": "WORKER_SELF_REFERENCE",
      "service": "noderia-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
